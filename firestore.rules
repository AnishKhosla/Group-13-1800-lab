rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile: name, streak, activity count. Any logged-in user can read (needed for search/following);
    // only the owner can write.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Private settings (phone, address, preferences): owner only.
      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // follows/{followerUid}_{followedUid}
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followedId;
      allow delete: if request.auth != null && resource.data.followerId == request.auth.uid;
    }
  }
}
